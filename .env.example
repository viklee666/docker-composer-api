# 对外监听
HOST=0.0.0.0
PORT=8787

# Cursor key 池：支持多个 key，逗号/分号/换行分隔。
# 网关模式按顺序使用第一个可用 key；遇到额度不足/无效 key 时立即切换下一个，
# 连续失败到 AUTO_DISABLE_THRESHOLD 次才自动禁用，额度恢复后在 /admin 管理后台手动重新启用。
# 也可以直接在后台添加/删除 key。
CURSOR_API_KEYS=
# 兼容旧的单 key 配置（会合并进 key 池）
CURSOR_API_KEY=

# 网关 key：客户端传 Authorization: Bearer <GATEWAY_API_KEY> 即走服务端 key 池
GATEWAY_API_KEY=

# /admin 管理后台密码；留空时退回使用 GATEWAY_API_KEY，两者都未设置则后台禁用
ADMIN_PASSWORD=

# 允许客户端直接把 Cursor API key 放在 Authorization Bearer 或 x-api-key
ALLOW_DIRECT_CURSOR_KEYS=true

# 状态库保存 Responses state、Cursor agent session、key 池与请求日志
SQLITE_PATH=/data/state.sqlite
CURSOR_WORKING_DIRECTORY=/workspace

# 单次上游运行超时；流式请求按“无输出空闲时间”计（每写出一个 SSE chunk 重置），不会误杀仍在吐字的长回答
REQUEST_TIMEOUT_MS=180000
CURSOR_SDK_CLIENT_VERSION=sdk-1.0.27
# API 网关默认不复用/恢复 Cursor SDK 远端 agent 会话；每次请求 fresh agent，避免服务跑一段时间后会话污染或老 agent 卡死导致持续 502。
CURSOR_SDK_DISABLE_SESSION_RESUME=true
# 强制 Cursor local agent backend streams 使用 HTTP/1.1 + SSE，而不是 HTTP/2。
# 代理/网络环境不兼容 HTTP/2 时可设为 true 试用。
CURSOR_SDK_USE_HTTP1_FOR_AGENT=false
# 是否允许 Cursor agent 在网关容器内使用自己的内置工具（shell/edit/grep 等）。
# 默认 false：无客户端工具的请求为纯文本模式，有客户端工具的请求只保留 MCP 元工具通道，
# 防止 agent 在网关侧真实执行文件/命令操作后又把调用转发给客户端造成双重执行。
CURSOR_ALLOW_BUILTIN_TOOLS=false

# 单次请求轮换 key 的最大尝试数（含成功前的失败次数），避免 key 极多时无界轮换放大上游压力
MAX_KEY_ATTEMPTS=10
# 单次请求软失败（换 key 但不禁用，如上游无详情 error）的最大重试数，超过即停手透出上游错误，
# 避免某模型在整池 key 上都不可用时把额度试个遍
MAX_TRANSIENT_KEY_ATTEMPTS=3

# 额度不足 / key 失效时是否自动禁用该 key。设为 false 则只轮换、永不自动停用（需自己盯额度）。
# 后台「运行设置」里改会持久化到数据库并覆盖这里的默认值。
AUTO_DISABLE_KEYS=true
# 连续失败多少次才自动禁用（成功一次即清零；人工启用也清零）。
# 设为 1 即老行为「一次失败就禁用」；调大可避免上游偶发抖动误伤好 key。
AUTO_DISABLE_THRESHOLD=2

# ===== 网关默认模型参数（可选；客户端在请求里显式指定时以客户端为准）=====
# 默认思考/推理强度：none/low/medium/high/xhigh/max
#（Claude 系映射为 thinking+effort，GPT/Codex 系映射为 reasoning，按模型实际支持的取值就近匹配）
CURSOR_REASONING_EFFORT=
# 默认开启 Max Mode / 大上下文（Claude/GPT 系映射为 context=1m 等最大档）
CURSOR_MAX_MODE=
# 默认使用 fast 变体
CURSOR_FAST=
# 默认透传的 Cursor model.params，格式 `id=value,id2=value2` 或 JSON 数组（优先级最高，原样发给 SDK）
CURSOR_MODEL_PARAMS=
# 默认 Cursor 会话模式 agent/plan
CURSOR_AGENT_MODE=

# 全局默认走 Sand 通道（x-cursor-client-type: sand，Grok Bot 额度）。
# 后台「运行设置」里改会持久化到数据库并覆盖这里的默认值；单个 key 仍可强制 SDK / Sand。
SAND_CLIENT_MODE=false
