# 对外监听
HOST=0.0.0.0
PORT=8787

# Cursor key 池：支持多个 key，逗号/分号/换行分隔。
# 默认按 ROUTING_STRATEGY=fill-first 取第一个可用 key；遇到额度不足/无效 key 时立即切换下一个，
# 连续失败到 AUTO_DISABLE_THRESHOLD 次才自动禁用，额度恢复后在 /admin 管理后台手动重新启用。
# 也可以直接在后台添加/删除 key，或用 cursor.com 的会话 token 让后台替你铸一个新 key。
# 每把 key 还能在后台单独限定可用模型（白名单/黑名单）与轮询权重。
CURSOR_API_KEYS=
# 兼容旧的单 key 配置（会合并进 key 池）
CURSOR_API_KEY=

# 网关 key：客户端传 Authorization: Bearer <GATEWAY_API_KEY> 即走服务端 key 池。
# 启动时会被播种进网关密钥表；之后可在后台「网关密钥」里再加任意多个，
# 并给每个密钥单独限定「只能用哪几把 Cursor key」「只能用哪些模型」。
GATEWAY_API_KEY=

# /admin 管理后台密码；留空时退回使用 GATEWAY_API_KEY，两者都未设置则后台禁用
ADMIN_PASSWORD=

# 允许客户端直接把 Cursor API key 放在 Authorization Bearer 或 x-api-key。后台「运行设置」可改。
ALLOW_DIRECT_CURSOR_KEYS=true

# 状态库保存 Responses state、Cursor agent session、key 池、网关密钥、会话绑定与请求历史
SQLITE_PATH=/data/state.sqlite
CURSOR_WORKING_DIRECTORY=/workspace
# 请求历史最多保留多少条，0（默认）= 不裁剪，全量留存。后台「运行设置」可改。
# 全量留存意味着状态库会随请求量无界增长（一条记录含用量、金额与模型参数快照，量级约 1KB），
# 长期高频跑的部署要么在这里设个上限，要么定期在后台「请求历史」里清空。
REQUEST_LOG_KEEP=0

# 单次上游运行超时；流式请求按“无输出空闲时间”计（每写出一个 SSE chunk 重置），不会误杀仍在吐字的长回答。后台「运行设置」可改。
REQUEST_TIMEOUT_MS=180000
CURSOR_SDK_CLIENT_VERSION=sdk-1.0.27
# 同会话复用一个本地 Agent（确定性 agentId），后续只发增量，上游 prompt 缓存才打得中。
# /health 的 sessionMode 必须是 durable；若是 stateless，Cache Read 会恒为 0，模型会像失忆一样重开每轮。
# Claude Code：会认 x-claude-code-session-id；子代理再带 x-claude-code-agent-id，主/子不会抢同一槽。
# Grok 的 Cache Write 恒为 0 是正常的。看 Cache Read，或 curl /health 里 durable.hitRatio。
# 后台「运行设置」可改，落库后优先于 env，立即生效（不必重启）。
CURSOR_SDK_SESSION_MODE=durable
# Kill switch：true 且后台从未保存过会话模式时强制 stateless。生产不要开。
# 后台保存过 durable 之后，这一项不再能把运行中的网关打回 stateless。
CURSOR_SDK_DISABLE_SESSION_RESUME=false
# 挂起工具 execute 最长等待（毫秒），默认 15 分钟。后台「运行设置」可改。
# CURSOR_SDK_TOOL_HOLD_TTL_MS=900000
# durable 空闲 agent 回收（毫秒），默认 60 分钟。后台「运行设置」可改。
# CURSOR_SDK_SESSION_IDLE_TTL_MS=3600000
# SessionHub / 共享内存 store 同时存活会话上限，默认 256。后台「运行设置」可改。
# CURSOR_SDK_MAX_LIVE_SESSIONS=256
# 强制 Cursor local agent backend streams 使用 HTTP/1.1 + SSE，而不是 HTTP/2。
# 建议留空：配了 PROXY_URL 时网关会自动打开它，因为 node:http2 完全不支持代理，
# 不开的话模型流量会绕过代理直连（墙内基本必然超时）。
# 写 true 表示任何情况下都强制 HTTP/1.1；写 false 表示「我知道模型流量不走代理，就这么办」——
# 网关会尊重这个选择，但会持续告警。别把 false 当默认值填在这里。
# 后台「运行设置」里那个三档下拉框选了强制开/关会落库，落库的取值比这里优先；
# 想把话语权还给这个环境变量，把它选回「未设置（配了代理就自动开）」。
CURSOR_SDK_USE_HTTP1_FOR_AGENT=

# 启动时预热 SDK 本地工作区（只为省掉首个请求的冷启动，与功能无关）。
# 预热会进 SDK 的原生工作区扫描，该扫描在部分宿主（实测 Windows + @cursor/sdk 1.0.27）
# 会直接触发 access violation 把进程打挂，而原生崩溃是 try/catch 抓不到的。
# 宿主机直跑（尤其 Windows）时若启动即崩，先把这个设成 false。
CURSOR_PREWARM=true
# 是否允许 Cursor agent 在网关容器内使用自己的内置工具（shell/edit/grep 等）。后台「运行设置」可改。
# 默认 false：无客户端工具的请求为纯文本模式，有客户端工具的请求只保留 MCP 元工具通道，
# 防止 agent 在网关侧真实执行文件/命令操作后又把调用转发给客户端造成双重执行。
CURSOR_ALLOW_BUILTIN_TOOLS=false

# 单次请求轮换 key 的最大尝试数（含成功前的失败次数），避免 key 极多时无界轮换放大上游压力。后台「运行设置」可改。
MAX_KEY_ATTEMPTS=10
# 单次请求软失败（换 key 但不禁用，如上游无详情 error）的最大重试数，超过即停手透出上游错误，
# 避免某模型在整池 key 上都不可用时把额度试个遍
MAX_TRANSIENT_KEY_ATTEMPTS=3

# 额度不足 / key 失效时是否自动禁用该 key。设为 false 则只轮换、永不自动停用（需自己盯额度）。
# 后台「运行设置」里改会持久化到数据库并覆盖这里的默认值。
AUTO_DISABLE_KEYS=true
# 连续失败多少次才自动禁用（成功一次即清零；人工启用也清零）。
# 设为 1 即老行为「一次失败就禁用」；调大可避免上游偶发抖动误伤好 key。
AUTO_DISABLE_THRESHOLD=2

# ===== 网关默认模型参数（可选；客户端在请求里显式指定时以客户端为准；后台「运行设置」可改）=====
# 默认思考/推理强度：none/low/medium/high/xhigh/max
#（Claude 系映射为 thinking+effort，GPT/Codex 系映射为 reasoning，按模型实际支持的取值就近匹配）
CURSOR_REASONING_EFFORT=
# Fast / Max Mode 的三态策略（两维各自独立）：
# - passthrough（默认）= 默认关闭、客户端可覆盖：客户端未表态的请求网关下发显式 false
#   （fast=false / 最小 context）。注意这不是字面「不写参数」：省略参数会让上游按目录默认档计费
#   （Composer / Grok 的默认档就是 Fast、Claude / GPT 默认档常是 1M）；
# - force-all = 全部支持的模型强制开启；
# - force-selected = 仅 CURSOR_*_MODELS 名单里的模型强制开启（逗号/分号/换行分隔，存 canonical id），
#   名单外的模型与 passthrough 同处理；空名单等同 passthrough。
# 旧值 true/false 仍被接受（true → force-all，false → passthrough）。
# 后台保存过会落库并优先于 env；CURSOR_MODEL_PARAMS 的显式 params 仍能盖过策略。
CURSOR_FAST=passthrough
CURSOR_FAST_MODELS=
CURSOR_MAX_MODE=passthrough
CURSOR_MAX_MODE_MODELS=
# 默认透传的 Cursor model.params，格式 `id=value,id2=value2` 或 JSON 数组（优先级最高，原样发给 SDK）
CURSOR_MODEL_PARAMS=
# 默认 Cursor 会话模式 agent/plan
CURSOR_AGENT_MODE=

# 全局默认走 Sand 通道（x-cursor-client-type: sand，Grok Bot 额度）。
# 后台「运行设置」里改会持久化到数据库并覆盖这里的默认值；单个 key 仍可强制 SDK / Sand。
SAND_CLIENT_MODE=false

# ===== key 取用策略与会话粘性（后台「运行设置」可改，改完即时生效并持久化）=====
# fill-first（默认）：按后台排序吃满第一个可用 key。
# round-robin：按每个 key 的 weight 加权轮询，摊平用量。
# 默认不轮询是有原因的：Cursor 按 key 缓存 prompt，换 key 就命中不到上一个 key 的缓存，
# 长上下文会被重复计费，所以除非你确实要摊平多账号用量，否则保持 fill-first。
ROUTING_STRATEGY=fill-first
# 会话粘性：同一会话固定复用上次成功的那个 key，保住上游 prompt 缓存。
# 绑定的 key 被禁用 / 删除 / 不允许当前模型时自动回退到正常选 key，不会把请求卡死。
# 没有可识别的客户端会话身份时不启用粘性，不会退到鉴权身份。
SESSION_AFFINITY=true
# 会话绑定的存活时长（毫秒），默认 1 小时；超时后重新按策略选 key。
SESSION_AFFINITY_TTL_MS=3600000

# ===== 出站代理（大陆网络访问 Cursor / 外国模型时需要）=====
# 支持 http / https / socks5 / socks5h / socks4，可带账号密码：socks5://user:pass@127.0.0.1:1080
# 只写 host:port 时按 http:// 处理。留空表示直连。后台「代理设置」可改。
# 配上这一项就够了：云端 REST 与模型流量两条链路都会被覆盖（五种协议都覆盖，socks4 也不例外），
# 模型那条需要 HTTP/1.1，所以上面那个开关会被自动顶成 true，
# 除非你显式写了 false、或在后台「运行设置」里把它选成了「强制关闭」（落库的取值优先级最高）。
# socks5:// 由网关本机解析域名，DNS 被污染时会连到错误的 IP；想让代理解析域名请用 socks5h://。
# socks4 还额外受限于「只能连 IPv4、只有 userId 没有密码」，能选 socks5h 就别选它。
# SOCKS 握手与 REQUEST_TIMEOUT_MS 共用截止时间，客户端断开时也会尽量立即拆掉握手 socket。
PROXY_URL=

# ===== 默认系统提示词（每个请求都会注入）=====
# off（默认）不注入；append 追加在客户端 system 之后；override 覆盖客户端 system。
SYSTEM_PROMPT_MODE=off
# 提示词正文（支持多行时建议在后台「系统提示词」里编辑，env 只适合单行）。
SYSTEM_PROMPT=
