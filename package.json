{
  "name": "docker-composer-api",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "description": "Docker-deployable OpenAI and Anthropic compatible API gateway for Cursor Composer.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "start": "node dist/src/index.js"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.27",
    "fastify": "^5.6.2",
    "https-proxy-agent": "^9.1.0",
    "socks": "^2.8.9",
    "socks-proxy-agent": "^10.1.0",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
